# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files - keep .env (portable config), uncomment to ignore:
# .env

# (fix 587) The "nul" file is a Git Bash trap: `2>nul` in bash creates
# a literal file with a Windows reserved name. Plus hidden startup
# error log and local backup of changes.
nul
start_error.log
/.backup-before-fixes/

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log

# installer cache (downloaded installer archives)
/.install-cache/

# ComfyUI portable install (copied separately, huge)
/ComfyUI-Easy-Install

# LLM Assistant Bonsai 2 27B (downloaded on demand, huge)
/Bonsai_2_27B

# DLSS bridge working data (job logs, render artifacts)
/upscale/jobs/
/upscale/logs/

# locally staged reference uploads (ComfyUI offline fallback)
/.local-input

# python bytecode cache
__pycache__/

# bundled runtimes and binaries (hundreds of MB, not for git: GitHub rejects files >100 MB)
/runtime/
/stt/
/upscale/bin/
/tools/ck_pkg/

# user working data (uploaded videos, chat attachments)
/data/upscale-input/
/data/upscale-output/
/data/chat-attachments/
/data/assistant-ref-cache/

# user state (chat history, unfinished generations, LoRA settings)
/data/assistant-chats.json
/data/inflight-generate.json
/data/loras.json

# internal development docs - not published to GitHub
/docs/

# release instructions in root - not tracked in git
/HOW_TO_RUN.txt
